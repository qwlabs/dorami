{
  "name": "@dorami/monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "rm -rf **/node_modules **/dist ./pnpm-lock.yaml && pnpm install",
    "link": "pnpm --filter './packages/*' dev:link",
    "release": "pnpm run build && pnpm recursive publish --filter './packages/*' --no-git-checks --report-summary",
    "build": "NODE_ENV=production pnpm run build:check && pnpm run build:packages",
    "build:check": "pnpm run format:check",
    "build:packages": "pnpm --filter './packages/*' build",
    "dev": "pnpm --filter showcase dev",
    "hot:dev": "DEV_ENV=hot pnpm --filter showcase dev",
    "format": "prettier --write \"**/*.{vue,js,mjs,ts,d.ts}\" --cache",
    "format:check": "prettier --check \"**/*.{vue,js,mjs,ts,d.ts}\"",
    "lint": "eslint . --cache",
    "lint:fix": "eslint --fix .",
    "test:unit": "pnpm --filter primevue test:unit",
    "taze": "taze -r"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/fs-extra": "catalog:dev",
    "@typescript-eslint/eslint-plugin": "catalog:dev",
    "@typescript-eslint/parser": "catalog:dev",
    "@typescript-eslint/type-utils": "catalog:dev",
    "@typescript-eslint/types": "catalog:dev",
    "@typescript-eslint/typescript-estree": "catalog:dev",
    "@typescript-eslint/utils": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-unused-imports": "catalog:dev",
    "eslint-plugin-vue": "catalog:dev",
    "fs-extra": "catalog:dev",
    "prettier": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "directory": "dist",
    "linkDirectory": true
  },
  "author": "Qwlabs",
  "homepage": "https://github.com/qwlabs/dorami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwlabs/dorami.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qwlabs/dorami/issues"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run build"
  }
}
